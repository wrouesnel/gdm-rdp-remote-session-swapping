+/*
+ * The launcher starts out assuming the session is active. A session can also be
+ * started while inactive on its seat (e.g. in the background for a remote
+ * client); sync the real state once the backend is fully set up, so the backend
+ * is paused now and resumed properly when the session is activated later.
+ */
+void
+meta_launcher_sync_initial_active (MetaLauncher *launcher)
+{
+  sync_active (launcher);
+}
