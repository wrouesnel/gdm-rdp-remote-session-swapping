+/**
+ * meta_monitor_manager_set_hide_physical_monitors:
+ * @manager: a #MetaMonitorManager
+ * @hide: whether physical monitors should be left out of the layout
+ *
+ * While @hide is set and at least one virtual monitor exists, only virtual
+ * monitors are part of the monitor layout. Takes effect on the next reload.
+ */
+void
+meta_monitor_manager_set_hide_physical_monitors (MetaMonitorManager *manager,
+                                                 gboolean            hide)
+{
+  MetaMonitorManagerPrivate *priv =
+    meta_monitor_manager_get_instance_private (manager);
+
+  priv->hide_physical_monitors = hide;
+}
+
+gboolean
+meta_monitor_manager_is_hiding_physical_monitors (MetaMonitorManager *manager)
+{
+  MetaMonitorManagerPrivate *priv =
+    meta_monitor_manager_get_instance_private (manager);
+
+  return priv->hide_physical_monitors && priv->virtual_monitors;
+}
