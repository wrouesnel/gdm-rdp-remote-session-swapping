+/* With RemoteLoginTakeover, a remote login of a user without a session starts
+ * that session in the background on seat0 (instead of headless and seat-less),
+ * already handed over to the remote client. It is then an ordinary local
+ * session that can be taken back and forth between the seat and remote
+ * clients like one started locally. */
+static void
+maybe_start_session_in_background (GdmManager *manager,
+                                   GdmSession *session)
+{
+        gboolean is_local = TRUE;
+        const char *username;
+
+        if (!remote_login_takeover_enabled (manager))
+                return;
+
+        g_object_get (G_OBJECT (session), "display-is-local", &is_local, NULL);
+        if (is_local || gdm_session_get_display_seat_id (session) != NULL)
+                return;
+
+        if (sd_seat_can_graphical ("seat0") <= 0 || sd_seat_can_tty ("seat0") <= 0) {
+                g_debug ("GdmManager: no graphical seat0 with VTs; starting remote session headless");
+                return;
+        }
+
+        username = gdm_session_get_username (session);
+        if (username == NULL || find_session_for_user (manager, username, session) != NULL)
+                return;
+
+        gdm_session_start_in_background_on_seat (session, "seat0");
+}
