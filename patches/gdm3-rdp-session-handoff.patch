+/**
+ * gdm_local_display_set_remote_id:
+ *
+ * Exposes the org.gnome.DisplayManager.RemoteDisplay interface on a local
+ * user session display, so remoting software (gnome-remote-desktop) can hand
+ * the remote client identified by @remote_id over to the session running on
+ * this display. The interface is added with the remote id already set, which
+ * the remoting software treats like a newly created remote user display;
+ * later calls only update the remote id, which it treats as a reconnection.
+ */
+void
+gdm_local_display_set_remote_id (GdmLocalDisplay *display,
+                                 const char      *remote_id)
+{
+        g_return_if_fail (GDM_IS_LOCAL_DISPLAY (display));
+
+        if (display->remote_skeleton != NULL) {
+                g_object_set (G_OBJECT (display->remote_skeleton), "remote-id", remote_id, NULL);
+                return;
+        }
+
+        display->remote_skeleton = GDM_DBUS_REMOTE_DISPLAY (gdm_dbus_remote_display_skeleton_new ());
+        g_object_set (G_OBJECT (display->remote_skeleton), "remote-id", remote_id, NULL);
+        g_object_bind_property (display, "session-id",
+                                display->remote_skeleton, "session-id",
+                                G_BINDING_SYNC_CREATE);
+
+        g_dbus_object_skeleton_add_interface (gdm_display_get_object_skeleton (GDM_DISPLAY (display)),
+                                              G_DBUS_INTERFACE_SKELETON (display->remote_skeleton));
+}
+
+gboolean
+gdm_local_display_is_remote_attached (GdmLocalDisplay *display)
+{
+        g_return_val_if_fail (GDM_IS_LOCAL_DISPLAY (display), FALSE);
+
+        return display->remote_skeleton != NULL;
+}
