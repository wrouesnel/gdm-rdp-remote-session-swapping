   GrdDaemonHandover *daemon_handover = GRD_DAEMON_HANDOVER (app);
 
+  maybe_watch_local_session (daemon_handover);
+
   grd_daemon_acquire_mutter_dbus_proxies (GRD_DAEMON (daemon_handover));
 
   g_signal_connect (daemon_handover, "mutter-proxy-acquired",
@@ -650,6 +880,12 @@ grd_daemon_handover_shutdown (GApplication *app)
   g_clear_handle_id (&daemon_handover->gnome_remote_desktop_watch_name_id,
                      g_bus_unwatch_name);
 
+  stop_watching_for_handover (daemon_handover);
+  uninhibit_sleep (daemon_handover);
+  g_clear_handle_id (&daemon_handover->login_monitor_source_id, g_source_remove);
+  g_clear_pointer (&daemon_handover->login_monitor, sd_login_monitor_unref);
+  g_clear_pointer (&daemon_handover->local_session_id, g_free);
+
   if (daemon_handover->prompt_cancellable)
     {
       g_cancellable_cancel (daemon_handover->prompt_cancellable);
