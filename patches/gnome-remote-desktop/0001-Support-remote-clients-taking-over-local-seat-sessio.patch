 src/grd-daemon-system.c   |  48 +++++++-
 src/grd-daemon-utils.c    |  26 +++++
 src/grd-daemon-utils.h    |   2 +
 src/grd-session-rdp.c     |   3 +
 src/grd-session-rdp.h     |   1 +
 6 files changed, 312 insertions(+), 4 deletions(-)

diff --git a/src/grd-daemon-handover.c b/src/grd-daemon-handover.c
index e80b1a5..80fc4bf 100644
--- a/src/grd-daemon-handover.c
+++ b/src/grd-daemon-handover.c
@@ -26,6 +26,8 @@
 
 #include <gio/gunixfdlist.h>
 #include <glib/gi18n.h>
+#include <glib-unix.h>
+#include <systemd/sd-login.h>
 #include <unistd.h>
 
 #include "grd-context.h"
@@ -52,10 +54,74 @@ struct _GrdDaemonHandover
   GCancellable *prompt_cancellable;
 
   unsigned int gnome_remote_desktop_watch_name_id;
+
+  /* Set when running in a local seat session that a remote client can take
+   * over (see GDM's RemoteLoginTakeover). */
+  char *local_session_id;
+  gboolean local_session_active;
+  sd_login_monitor *login_monitor;
+  unsigned int login_monitor_source_id;
+  unsigned int handovers_added_subscription_id;
+  GDBusConnection *handovers_connection;
+
+  /* logind sleep/idle inhibitor held while a remote client drives the local
+   * session: the seat sits idle on a login screen meanwhile. */
+  int sleep_inhibitor_fd;
 };
 
 G_DEFINE_TYPE (GrdDaemonHandover, grd_daemon_handover, GRD_TYPE_DAEMON)
 
+static void watch_for_handover (GrdDaemonHandover *daemon_handover);
+static void stop_watching_for_handover (GrdDaemonHandover *daemon_handover);
+
+static void
+inhibit_sleep (GrdDaemonHandover *daemon_handover)
+{
+  g_autoptr (GDBusConnection) connection = NULL;
+  g_autoptr (GUnixFDList) fd_list = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GError) error = NULL;
+  int fd_index;
+
+  if (daemon_handover->sleep_inhibitor_fd >= 0)
+    return;
+
+  connection = g_bus_get_sync (G_BUS_TYPE_SYSTEM, NULL, &error);
+  if (connection)
+    {
+      reply = g_dbus_connection_call_with_unix_fd_list_sync (
+        connection,
+        "org.freedesktop.login1",
+        "/org/freedesktop/login1",
+        "org.freedesktop.login1.Manager",
+        "Inhibit",
+        g_variant_new ("(ssss)", "sleep:idle", "GNOME Remote Desktop",
+                       "A remote client is using the session", "block"),
+        G_VARIANT_TYPE ("(h)"),
+        G_DBUS_CALL_FLAGS_NONE,
+        -1, NULL, &fd_list, NULL, &error);
+    }
+
+  if (!reply)
+    {
+      g_warning ("[DaemonHandover] Failed to inhibit sleep: %s", error->message);
+      return;
+    }
+
+  g_variant_get (reply, "(h)", &fd_index);
+  daemon_handover->sleep_inhibitor_fd = g_unix_fd_list_get (fd_list, fd_index, NULL);
+}
+
+static void
+uninhibit_sleep (GrdDaemonHandover *daemon_handover)
+{
+  if (daemon_handover->sleep_inhibitor_fd < 0)
+    return;
+
+  close (daemon_handover->sleep_inhibitor_fd);
+  daemon_handover->sleep_inhibitor_fd = -1;
+}
+
 static gboolean
 grd_daemon_handover_is_ready (GrdDaemon *daemon)
 {
@@ -265,6 +331,8 @@ on_session_stopped (GrdSession        *session,
 
   daemon_handover->session = NULL;
 
+  uninhibit_sleep (daemon_handover);
+
   if (daemon_handover->prompt_cancellable)
     {
       g_cancellable_cancel (daemon_handover->prompt_cancellable);
@@ -361,6 +429,19 @@ on_incoming_new_connection (GrdRdpServer      *rdp_server,
 
   daemon_handover->session = session;
 
+  if (daemon_handover->local_session_id &&
+      daemon_handover->local_session_active)
+    {
+      g_message ("[DaemonHandover] Local session %s is active on its seat, "
+                 "refusing remote client", daemon_handover->local_session_id);
+      grd_session_rdp_notify_error (GRD_SESSION_RDP (session),
+                                    GRD_SESSION_RDP_ERROR_LOGOFF_BY_USER);
+      return;
+    }
+
+  if (daemon_handover->local_session_id)
+    inhibit_sleep (daemon_handover);
+
   grd_settings_recreate_rdp_credentials (settings);
 
   if (daemon_handover->use_system_credentials && grd_is_remote_login ())
@@ -478,6 +559,8 @@ on_remote_desktop_rdp_handover_proxy_acquired (GObject      *object,
 
   daemon_handover->remote_desktop_handover = g_steal_pointer (&proxy);
 
+  stop_watching_for_handover (daemon_handover);
+
   g_signal_connect (daemon_handover->remote_desktop_handover, "redirect-client",
                     G_CALLBACK (on_redirect_client), daemon_handover);
   g_signal_connect (daemon_handover->remote_desktop_handover, "restart-handover",
@@ -486,6 +569,19 @@ on_remote_desktop_rdp_handover_proxy_acquired (GObject      *object,
   grd_daemon_maybe_enable_services (GRD_DAEMON (daemon_handover));
 }
 
+static void
+stop_watching_for_handover (GrdDaemonHandover *daemon_handover)
+{
+  if (daemon_handover->handovers_added_subscription_id)
+    {
+      g_dbus_connection_signal_unsubscribe (
+        daemon_handover->handovers_connection,
+        daemon_handover->handovers_added_subscription_id);
+      daemon_handover->handovers_added_subscription_id = 0;
+    }
+  g_clear_object (&daemon_handover->handovers_connection);
+}
+
 static void
 on_remote_desktop_rdp_dispatcher_handover_requested (GObject      *object,
                                                      GAsyncResult *result,
@@ -506,6 +602,15 @@ on_remote_desktop_rdp_dispatcher_handover_requested (GObject      *object,
       &error);
   if (!success)
     {
+      if (daemon_handover->local_session_id)
+        {
+          g_debug ("[DaemonHandover] No handover for local session %s yet, "
+                   "waiting for a remote takeover: %s",
+                   daemon_handover->local_session_id, error->message);
+          watch_for_handover (daemon_handover);
+          return;
+        }
+
       g_warning ("[DaemonHandover] Failed to request remote desktop "
                  "handover: %s", error->message);
       return;
@@ -524,6 +629,118 @@ on_remote_desktop_rdp_dispatcher_handover_requested (GObject      *object,
     daemon_handover);
 }
 
+static void
+on_handover_interfaces_added (GDBusConnection *connection,
+                              const char      *sender_name,
+                              const char      *object_path,
+                              const char      *interface_name,
+                              const char      *signal_name,
+                              GVariant        *parameters,
+                              gpointer         user_data)
+{
+  GrdDaemonHandover *daemon_handover = user_data;
+  GCancellable *cancellable =
+    grd_daemon_get_cancellable (GRD_DAEMON (daemon_handover));
+
+  if (daemon_handover->remote_desktop_handover ||
+      !daemon_handover->remote_desktop_dispatcher)
+    return;
+
+  /* The system daemon only lets us request the handover object that belongs
+   * to our session, so simply try again whenever a new one appears. */
+  grd_dbus_remote_desktop_rdp_dispatcher_call_request_handover (
+    daemon_handover->remote_desktop_dispatcher,
+    cancellable,
+    on_remote_desktop_rdp_dispatcher_handover_requested,
+    daemon_handover);
+}
+
+static void
+watch_for_handover (GrdDaemonHandover *daemon_handover)
+{
+  GDBusConnection *connection;
+
+  if (daemon_handover->handovers_added_subscription_id)
+    return;
+
+  connection = g_dbus_proxy_get_connection (
+                 G_DBUS_PROXY (daemon_handover->remote_desktop_dispatcher));
+  daemon_handover->handovers_connection = g_object_ref (connection);
+
+  daemon_handover->handovers_added_subscription_id =
+    g_dbus_connection_signal_subscribe (connection,
+                                        REMOTE_DESKTOP_BUS_NAME,
+                                        "org.freedesktop.DBus.ObjectManager",
+                                        "InterfacesAdded",
+                                        REMOTE_DESKTOP_HANDOVERS_OBJECT_PATH,
+                                        NULL,
+                                        G_DBUS_SIGNAL_FLAGS_NONE,
+                                        on_handover_interfaces_added,
+                                        daemon_handover, NULL);
+}
+
+static gboolean
+on_login_monitor_event (int           fd,
+                        GIOCondition  condition,
+                        gpointer      user_data)
+{
+  GrdDaemonHandover *daemon_handover = user_data;
+  gboolean active;
+
+  sd_login_monitor_flush (daemon_handover->login_monitor);
+
+  active = sd_session_is_active (daemon_handover->local_session_id) > 0;
+  if (active == daemon_handover->local_session_active)
+    return G_SOURCE_CONTINUE;
+
+  daemon_handover->local_session_active = active;
+  g_debug ("[DaemonHandover] Local session %s is now %s",
+           daemon_handover->local_session_id, active ? "active" : "inactive");
+
+  /* The console user took the session back: disconnect the remote client. */
+  if (active && daemon_handover->session)
+    {
+      g_message ("[DaemonHandover] Local session %s reclaimed on its seat, "
+                 "disconnecting remote client",
+                 daemon_handover->local_session_id);
+      grd_session_rdp_notify_error (GRD_SESSION_RDP (daemon_handover->session),
+                                    GRD_SESSION_RDP_ERROR_LOGOFF_BY_USER);
+    }
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+maybe_watch_local_session (GrdDaemonHandover *daemon_handover)
+{
+  int ret;
+
+  daemon_handover->local_session_id = grd_get_local_seat_session_id ();
+  if (!daemon_handover->local_session_id)
+    return;
+
+  daemon_handover->local_session_active =
+    sd_session_is_active (daemon_handover->local_session_id) > 0;
+
+  ret = sd_login_monitor_new ("session", &daemon_handover->login_monitor);
+  if (ret < 0)
+    {
+      g_warning ("[DaemonHandover] Failed to monitor logind sessions: %s",
+                 g_strerror (-ret));
+      return;
+    }
+
+  daemon_handover->login_monitor_source_id =
+    g_unix_fd_add (sd_login_monitor_get_fd (daemon_handover->login_monitor),
+                   G_IO_IN,
+                   on_login_monitor_event,
+                   daemon_handover);
+
+  g_message ("[DaemonHandover] Running in local session %s; remote clients "
+             "can take it over while it is inactive on its seat",
+             daemon_handover->local_session_id);
+}
+
 static void
 on_remote_desktop_rdp_dispatcher_proxy_acquired (GObject      *object,
                                                  GAsyncResult *result,
@@ -583,6 +800,16 @@ on_gnome_remote_desktop_name_vanished (GDBusConnection *connection,
