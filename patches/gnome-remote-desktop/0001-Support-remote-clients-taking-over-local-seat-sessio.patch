+/*
+ * Returns the id of the session this process belongs to if it is a local
+ * session on a seat (i.e. a physical console session), otherwise NULL.
+ */
+char *
+grd_get_local_seat_session_id (void)
+{
+  g_autofree char *session_id = NULL;
+  g_autofree char *seat = NULL;
+
+  session_id = grd_get_session_id_from_pid (getpid ());
+  if (!session_id)
+    session_id = grd_get_session_id_from_uid (getuid ());
+
+  if (!session_id)
+    return NULL;
+
+  if (sd_session_get_seat (session_id, &seat) < 0 || !seat)
+    return NULL;
+
+  if (sd_session_is_remote (session_id) > 0)
+    return NULL;
+
+  return g_steal_pointer (&session_id);
+}
