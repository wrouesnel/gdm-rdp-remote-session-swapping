From e515928b525fd575aa4a5a5c4f454ebfb3ec996b Mon Sep 17 00:00:00 2001
From: will <wrouesnel@wrouesnel.com>
Date: Tue, 29 Sep 2026 12:23:18 +1000
Subject: [PATCH 1/3] remote-display-factory: Don't warn about local displays

The display store contains local displays too; ignore them instead of
triggering g_return_if_fail() for every local display added or removed.
---
 daemon/gdm-remote-display-factory.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/daemon/gdm-remote-display-factory.c b/daemon/gdm-remote-display-factory.c
index 0e47e96..65799ae 100644
--- a/daemon/gdm-remote-display-factory.c
+++ b/daemon/gdm-remote-display-factory.c
@@ -252,7 +252,9 @@ on_display_added (GdmDisplayStore         *store,
 {
         GdmDisplay *display = gdm_display_store_lookup (store, id);
 
-        g_return_if_fail (GDM_IS_REMOTE_DISPLAY (display));
+        /* The store holds local displays too; only remote ones count. */
+        if (!GDM_IS_REMOTE_DISPLAY (display))
+                return;
 
         factory->remote_displays_count++;
 
@@ -278,7 +280,8 @@ on_display_removed (GdmDisplayStore         *display_store,
 {
         g_assert (factory->remote_displays_count >= 0);
 
-        g_return_if_fail (GDM_IS_REMOTE_DISPLAY (display));
+        if (!GDM_IS_REMOTE_DISPLAY (display))
+                return;
 
         factory->remote_displays_count--;
 
-- 
