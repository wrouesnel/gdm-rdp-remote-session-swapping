 daemon/gdm-local-display.c |  45 +++++++++++
 daemon/gdm-local-display.h |   4 +
 daemon/gdm-manager.c       | 161 ++++++++++++++++++++++++++++++++++++-
 data/gdm.schemas.in        |   5 ++
 5 files changed, 214 insertions(+), 2 deletions(-)

