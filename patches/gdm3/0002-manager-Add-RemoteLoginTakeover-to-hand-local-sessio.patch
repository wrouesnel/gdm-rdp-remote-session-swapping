+/* RemoteLoginTakeover: a user authenticating at a remote login screen may take
+ * over their existing session on a local seat. The seat is switched to a login
+ * screen and the session is handed to the remote client; logging in locally
+ * again takes it back (the remote client is disconnected by the remoting
+ * software when the session becomes active on the seat again).
+ */
+static gboolean
+remote_login_takeover_enabled (GdmManager *manager)
+{
+        gboolean enabled = FALSE;
+
+        if (!manager->remote_login_enabled)
+                return FALSE;
+
+        gdm_settings_direct_get_boolean (GDM_KEY_REMOTE_LOGIN_TAKEOVER, &enabled);
+        return enabled;
+}
+
+static gboolean
+can_remote_take_over_session (GdmManager *manager,
+                              GdmSession *login_session,
+                              GdmSession *user_session)
+{
+        gboolean login_is_local = TRUE;
+        gboolean user_is_local = FALSE;
+
+        if (!remote_login_takeover_enabled (manager))
+                return FALSE;
+
+        g_object_get (G_OBJECT (login_session), "display-is-local", &login_is_local, NULL);
+        g_object_get (G_OBJECT (user_session), "display-is-local", &user_is_local, NULL);
+
+        return !login_is_local &&
+               user_is_local &&
+               gdm_session_get_display_seat_id (user_session) != NULL;
+}
+
 static gboolean
 gdm_manager_handle_open_reauthentication_channel (GdmDBusManager        *manager,
                                                   GDBusMethodInvocation *invocation,
@@ -1203,7 +1253,8 @@ gdm_manager_handle_open_reauthentication_channel (GdmDBusManager        *manager
         }
 
         if (session != NULL && login_session != NULL &&
-            !are_sessions_compatible (session, login_session)) {
+            !are_sessions_compatible (session, login_session) &&
+            !can_remote_take_over_session (self, login_session, session)) {
                 g_dbus_method_invocation_return_error_literal (invocation,
                                                                G_DBUS_ERROR,
                                                                G_DBUS_ERROR_ACCESS_DENIED,
@@ -2133,6 +2184,105 @@ lookup_by_reauth_pid (const char *id,
         return looking_for == current;
 }
 
+typedef struct {
+        GdmManager *manager;
+        GdmDisplay *user_display;
+        char       *session_id;
+        char       *remote_id;
+        guint       attempts;
+} RemoteTakeoverOperation;
+
+static void
+remote_takeover_operation_free (RemoteTakeoverOperation *operation)
+{
+        g_object_unref (operation->manager);
+        g_object_unref (operation->user_display);
+        g_free (operation->session_id);
+        g_free (operation->remote_id);
+        g_free (operation);
+}
+
+#define REMOTE_TAKEOVER_POLL_INTERVAL_MS 100
+#define REMOTE_TAKEOVER_MAX_ATTEMPTS 150
+
+static gboolean
+complete_remote_takeover (gpointer user_data)
+{
+        RemoteTakeoverOperation *operation = user_data;
+
+        /* Only hand the session to the remote client once it has left the
+         * physical seat, so nothing it shows reaches the local outputs and the
+         * compositor has released the local input devices. */
+        if (sd_session_is_active (operation->session_id) > 0) {
+                if (++operation->attempts < REMOTE_TAKEOVER_MAX_ATTEMPTS)
+                        return G_SOURCE_CONTINUE;
+
+                g_warning ("GdmManager: session %s did not leave its seat; "
+                           "not handing it over to remote client %s",
+                           operation->session_id, operation->remote_id);
+                remote_takeover_operation_free (operation);
+                return G_SOURCE_REMOVE;
+        }
+
+        g_debug ("GdmManager: handing session %s over to remote client %s",
+                 operation->session_id, operation->remote_id);
+
+        /* The remote user just authenticated as the session owner; don't make
+         * them unlock the session's own lock screen again. */
+        session_unlock (operation->manager, operation->session_id);
+
+        gdm_local_display_set_remote_id (GDM_LOCAL_DISPLAY (operation->user_display),
+                                         operation->remote_id);
+
+        remote_takeover_operation_free (operation);
+        return G_SOURCE_REMOVE;
+}
+
+static gboolean
+start_remote_takeover (GdmManager *manager,
+                       GdmSession *user_session,
+                       GdmDisplay *login_display,
+                       GdmDisplay *user_display)
+{
+        RemoteTakeoverOperation *operation;
+        const char *session_id = gdm_session_get_session_id (user_session);
+        const char *seat_id = gdm_session_get_display_seat_id (user_session);
+        g_autofree char *greeter_session_id = NULL;
+        g_autoptr (GError) error = NULL;
+
+        g_debug ("GdmManager: remote login taking over session %s on %s",
+                 session_id, seat_id);
+
+        /* Put the seat on a login screen; the user session keeps running. */
+        if (gdm_get_login_window_session_id (seat_id, &greeter_session_id) &&
+            greeter_session_id != NULL) {
+                if (!gdm_activate_session_by_id (manager->connection, NULL,
+                                                 seat_id, greeter_session_id)) {
+                        g_warning ("GdmManager: failed to activate login screen on %s", seat_id);
+                        return FALSE;
+                }
+        } else {
+                g_autofree char *display_id = NULL;
+
+                if (!gdm_local_display_factory_create_transient_display (manager->local_factory,
+                                                                         &display_id,
+                                                                         &error)) {
+                        g_warning ("GdmManager: failed to start login screen on %s: %s",
+                                   seat_id, error->message);
+                        return FALSE;
+                }
+        }
+
+        operation = g_new0 (RemoteTakeoverOperation, 1);
+        operation->manager = g_object_ref (manager);
+        operation->user_display = g_object_ref (user_display);
+        operation->session_id = g_strdup (session_id);
+        operation->remote_id = gdm_remote_display_get_remote_id (GDM_REMOTE_DISPLAY (login_display));
+
+        g_timeout_add (REMOTE_TAKEOVER_POLL_INTERVAL_MS, complete_remote_takeover, operation);
+        return TRUE;
+}
+
 static void
 on_session_reauthenticated (GdmSession *session,
                             const char *service_name,
@@ -2154,7 +2304,14 @@ on_session_reauthenticated (GdmSession *session,
                                                                lookup_by_session_id,
                                                                (gpointer) session_id);
 
-                        if (user_display != NULL && GDM_IS_REMOTE_DISPLAY (user_display)) {
+                        if (user_display != NULL && GDM_IS_LOCAL_DISPLAY (user_display) &&
+                            remote_login_takeover_enabled (manager)) {
+                                /* The remoting software closes the remote
+                                 * login screen once the client has been
+                                 * redirected, as in the remote case below. */
+                                start_remote_takeover (manager, session, login_display, user_display);
+                                return;
+                        } else if (user_display != NULL && GDM_IS_REMOTE_DISPLAY (user_display)) {
                                 /* Transferring the remote id from the new login screen display to the
                                  * preexisting user session display, notifies the remoting software to redirect
                                  * the connection. That same software will also ensure after the redirection has
