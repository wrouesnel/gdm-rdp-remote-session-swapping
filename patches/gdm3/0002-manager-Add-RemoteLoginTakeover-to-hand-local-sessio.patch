@@ -80,6 +85,7 @@ gdm_local_display_finalize (GObject *object)
         GdmLocalDisplay *display = GDM_LOCAL_DISPLAY (object);
 
         g_clear_object (&display->skeleton);
+        g_clear_object (&display->remote_skeleton);
 
