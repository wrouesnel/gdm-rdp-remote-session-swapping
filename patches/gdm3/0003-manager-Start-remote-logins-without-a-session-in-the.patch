From f1472b3c0bb77a1c7c71490ebd38f4e90f972a76 Mon Sep 17 00:00:00 2001
From: will <wrouesnel@wrouesnel.com>
Date: Tue, 29 Sep 2026 12:57:04 +1000
Subject: [PATCH 3/3] manager: Start remote logins without a session in the
 background on seat0

With RemoteLoginTakeover, a remote login of a user who has no session no longer
starts a seat-less headless session (which could never be brought to the
physical seat). Instead the session is opened as a local seat0 session on a VT
of its own that is not switched to (LOGIND_MANAGED display mode, no PAM_RHOST),
and handed to the remote client right away through the RemoteDisplay interface
on its GdmLocalDisplay. It is then an ordinary local session: logging in at the
seat takes it over, and later remote logins take it over again.

Adds a SetSessionSeat worker method to open the session on a seat other than
the (remote) display the conversation was set up for.
---
 daemon/gdm-manager.c          | 44 ++++++++++++++++++++++++++++++++
 daemon/gdm-session-worker.c   | 25 ++++++++++++++++++
 daemon/gdm-session-worker.xml |  3 +++
 daemon/gdm-session.c          | 48 +++++++++++++++++++++++++++++++++++
 daemon/gdm-session.h          |  3 +++
 5 files changed, 123 insertions(+)

diff --git a/daemon/gdm-manager.c b/daemon/gdm-manager.c
index 5ad5cb3..7c9a08f 100644
--- a/daemon/gdm-manager.c
+++ b/daemon/gdm-manager.c
@@ -1769,6 +1769,17 @@ create_display_for_user_session (GdmManager *self,
                       NULL);
         gdm_display_store_add (self->display_store,
                                display);
+
+        /* A remote login started in the background on a local seat: hand the
+         * session to the remote client right away. */
+        if (GDM_IS_LOCAL_DISPLAY (display) && gdm_session_is_background (session)) {
+                g_autofree char *remote_id = NULL;
+
+                g_object_get (G_OBJECT (session), "remote-id", &remote_id, NULL);
+                if (remote_id != NULL && remote_id[0] != '\0')
+                        gdm_local_display_set_remote_id (GDM_LOCAL_DISPLAY (display), remote_id);
+        }
+
         g_object_set_data (G_OBJECT (session), "gdm-display", display);
         g_object_set_data_full (G_OBJECT (display),
                                 "gdm-user-session",
@@ -2038,6 +2049,37 @@ on_session_authentication_failed (GdmSession *session,
         add_session_record (manager, session, conversation_pid, SESSION_RECORD_FAILED);
 }
 
+/* With RemoteLoginTakeover, a remote login of a user without a session starts
+ * that session in the background on seat0 (instead of headless and seat-less),
+ * already handed over to the remote client. It is then an ordinary local
+ * session that can be taken back and forth between the seat and remote
+ * clients like one started locally. */
+static void
+maybe_start_session_in_background (GdmManager *manager,
+                                   GdmSession *session)
+{
+        gboolean is_local = TRUE;
+        const char *username;
+
+        if (!remote_login_takeover_enabled (manager))
+                return;
+
+        g_object_get (G_OBJECT (session), "display-is-local", &is_local, NULL);
+        if (is_local || gdm_session_get_display_seat_id (session) != NULL)
+                return;
+
+        if (sd_seat_can_graphical ("seat0") <= 0 || sd_seat_can_tty ("seat0") <= 0) {
+                g_debug ("GdmManager: no graphical seat0 with VTs; starting remote session headless");
+                return;
+        }
+
+        username = gdm_session_get_username (session);
+        if (username == NULL || find_session_for_user (manager, username, session) != NULL)
+                return;
+
+        gdm_session_start_in_background_on_seat (session, "seat0");
+}
+
 static void
 on_session_credentials_established (GdmSession *session,
                                     const char *service_name,
@@ -2052,6 +2094,8 @@ on_session_credentials_established (GdmSession *session,
                 return;
         }
 
+        maybe_start_session_in_background (manager, session);
+
         /* If this is the initial setup, chown the g-i-s homedir now before the
          * PAM session is opened and the consumers are started.
          */
diff --git a/daemon/gdm-session-worker.c b/daemon/gdm-session-worker.c
index 25760b5..937c004 100644
--- a/daemon/gdm-session-worker.c
+++ b/daemon/gdm-session-worker.c
@@ -2590,6 +2590,30 @@ gdm_session_worker_handle_set_session_display_mode (GdmDBusWorker         *objec
         return TRUE;
 }
 
+/* Open the session on a local seat instead of the (remote) display the
+ * conversation was set up for; see gdm_session_start_in_background_on_seat(). */
+static gboolean
+gdm_session_worker_handle_set_session_seat (GdmDBusWorker         *object,
+                                            GDBusMethodInvocation *invocation,
+                                            const char            *seat_id)
+{
+        GdmSessionWorker *worker = GDM_SESSION_WORKER (object);
+
+        g_debug ("GdmSessionWorker: session will be opened on seat %s", seat_id);
+
+        g_free (worker->display_seat_id);
+        worker->display_seat_id = g_strdup (seat_id);
+        worker->display_is_local = TRUE;
+
+        if (worker->pam_handle != NULL)
+                pam_set_item (worker->pam_handle, PAM_RHOST, NULL);
+
+        gdm_session_worker_set_environment_variable (worker, "XDG_SEAT", seat_id);
+
+        gdm_dbus_worker_complete_set_session_seat (object, invocation);
+        return TRUE;
+}
+
 static gboolean
 gdm_session_worker_handle_set_language_name (GdmDBusWorker         *object,
                                              GDBusMethodInvocation *invocation,
@@ -3522,6 +3546,7 @@ worker_interface_init (GdmDBusWorkerIface *interface)
         interface->handle_set_language_name = gdm_session_worker_handle_set_language_name;
         interface->handle_set_session_name = gdm_session_worker_handle_set_session_name;
         interface->handle_set_session_display_mode = gdm_session_worker_handle_set_session_display_mode;
+        interface->handle_set_session_seat = gdm_session_worker_handle_set_session_seat;
         interface->handle_set_environment_variable = gdm_session_worker_handle_set_environment_variable;
         interface->handle_start_program = gdm_session_worker_handle_start_program;
         interface->handle_start_reauthentication = gdm_session_worker_handle_start_reauthentication;
diff --git a/daemon/gdm-session-worker.xml b/daemon/gdm-session-worker.xml
index 214ca8d..b5ffbd0 100644
--- a/daemon/gdm-session-worker.xml
+++ b/daemon/gdm-session-worker.xml
@@ -16,6 +16,9 @@
     <method name="SetSessionDisplayMode">
       <arg name="mode" direction="in" type="s"/>
     </method>
+    <method name="SetSessionSeat">
+      <arg name="seat_id" direction="in" type="s"/>
+    </method>
     <method name="SetEnvironmentVariable">
       <arg name="name" direction="in" type="s"/>
       <arg name="value" direction="in" type="s"/>
diff --git a/daemon/gdm-session.c b/daemon/gdm-session.c
index f8495c8..e84a152 100644
--- a/daemon/gdm-session.c
+++ b/daemon/gdm-session.c
@@ -127,6 +127,10 @@ struct _GdmSession
         char                *display_x11_authority_file;
         gboolean             display_is_local;
 
+        /* Set when a login from a remote display is started as a local
+         * session on this seat instead, without activating it there. */
+        char                *background_seat_id;
+
         GdmSessionVerificationMode verification_mode;
 
         uid_t                allowed_user;
@@ -3001,6 +3005,11 @@ gdm_session_open_session (GdmSession *self,
         conversation = find_conversation_by_name (self, service_name);
 
         if (conversation != NULL) {
+                if (self->background_seat_id != NULL)
+                        gdm_dbus_worker_call_set_session_seat (conversation->worker_proxy,
+                                                               self->background_seat_id,
+                                                               conversation->worker_cancellable,
+                                                               NULL, NULL);
                 send_display_mode (self, conversation);
                 send_session_type (self, conversation);
 
@@ -3475,6 +3484,39 @@ gdm_session_get_display_device (GdmSession *self)
         return self->display_device;
 }
 
+/**
+ * gdm_session_start_in_background_on_seat:
+ *
+ * Makes the session about to be opened by this (remote) login a local
+ * session on @seat_id, on a VT of its own that is not switched to. From then
+ * on the session behaves like any other local session on that seat, so it can
+ * be brought to the seat later by logging in there. Must be called before the
+ * session is opened.
+ */
+void
+gdm_session_start_in_background_on_seat (GdmSession *self,
+                                         const char *seat_id)
+{
+        g_return_if_fail (GDM_IS_SESSION (self));
+
+        g_debug ("GdmSession: starting session in the background on %s", seat_id);
+
+        g_free (self->background_seat_id);
+        self->background_seat_id = g_strdup (seat_id);
+
+        g_free (self->display_seat_id);
+        self->display_seat_id = g_strdup (seat_id);
+        self->display_is_local = TRUE;
+}
+
+gboolean
+gdm_session_is_background (GdmSession *self)
+{
+        g_return_val_if_fail (GDM_IS_SESSION (self), FALSE);
+
+        return self->background_seat_id != NULL;
+}
+
 const char *
 gdm_session_get_display_seat_id (GdmSession *self)
 {
@@ -3651,6 +3693,11 @@ gdm_session_get_display_mode (GdmSession *self)
 {
         g_return_val_if_fail (GDM_IS_SESSION (self), GDM_SESSION_DISPLAY_MODE_NEW_VT);
 
+        /* Background sessions get a VT of their own, but GDM must not jump to
+         * it: the seat keeps showing whatever it shows now. */
+        if (self->background_seat_id != NULL)
+                return GDM_SESSION_DISPLAY_MODE_LOGIND_MANAGED;
+
         g_debug ("GdmSession: type %s, program? %s, seat %s",
                  self->session_type,
                  self->is_program_session? "yes" : "no",
@@ -3999,6 +4046,7 @@ gdm_session_dispose (GObject *object)
         self->display_device = NULL;
 
         g_free (self->display_seat_id);
+        g_clear_pointer (&self->background_seat_id, g_free);
         self->display_seat_id = NULL;
 
         g_free (self->display_x11_authority_file);
diff --git a/daemon/gdm-session.h b/daemon/gdm-session.h
index a20a2c6..17f59b7 100644
--- a/daemon/gdm-session.h
+++ b/daemon/gdm-session.h
@@ -75,6 +75,9 @@ const char       *gdm_session_get_server_address          (GdmSession     *sessi
 const char       *gdm_session_get_username                (GdmSession     *session);
 const char       *gdm_session_get_display_device          (GdmSession     *session);
 const char       *gdm_session_get_display_seat_id         (GdmSession     *session);
+void              gdm_session_start_in_background_on_seat (GdmSession     *session,
+                                                           const char     *seat_id);
+gboolean          gdm_session_is_background               (GdmSession     *session);
 const char       *gdm_session_get_session_id              (GdmSession     *session);
 gboolean          gdm_session_bypasses_xsession           (GdmSession     *session);
 gboolean          gdm_session_session_registers           (GdmSession     *session);
